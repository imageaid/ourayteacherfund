<%# Optional local: extra_params (hash) is sent along with the next page, e.g. active filters. %>
<div class="flex mt-8">
  <% if pagy.next.present? %>
    <%= button_to "Load more", path, class: 'btn-secondary', params: local_assigns.fetch(:extra_params, {}).merge(page: pagy.next), method: :get, "data-turbo-stream": true, "data-turbo-submits-with": "Loading ..." %>
  <% end %>
  <% if pagy.page > 1 %>
    <%= link_to 'Reset', path, class: 'btn-default ml-2' %>
  <% end %>
</div>
